<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.BoxBlur?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1" fx:controller="UI.PlayerSearchMenuCtrl">
   <children>
      <Label layoutX="323.0" layoutY="5.0" prefHeight="44.0" prefWidth="173.0" style="-fx-background-color: rgb(179,183,245); -fx-padding: 10 10 10 10; " text="Player Search Menu" wrapText="true">
         <font>
            <Font name="Uni-Sans-Bold-Italic" size="18.0" />
         </font>
      </Label>

      <Button layoutX="5.0" layoutY="5.0" mnemonicParsing="false" onAction="#backButton" prefWidth="0.0" style="-fx-padding: 1 1 1 1; -fx-background-color: transparent">
         <graphic>
            <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/back.png" />
               </image>
            </ImageView>
         </graphic>
         <effect>
            <BoxBlur />
         </effect>
      </Button>
      <Button layoutX="110.0" layoutY="145.0" mnemonicParsing="false" onAction="#goName" prefHeight="70.0" prefWidth="140.0" text="By Name" textAlignment="CENTER" wrapText="true">
         <font>
            <Font size="15.0" />
         </font></Button>
      <Button layoutX="110.0" layoutY="225.0" mnemonicParsing="false" onAction="#goPos" prefHeight="70.0" prefWidth="140.0" text="By Position" textAlignment="CENTER" wrapText="true">
         <font>
            <Font size="15.0" />
         </font></Button>
      <Button layoutX="260.0" layoutY="225.0" mnemonicParsing="false" onAction="#goSR" prefHeight="70.0" prefWidth="140.0" text="By Salary-Range" textAlignment="CENTER" wrapText="true">
         <font>
            <Font size="15.0" />
         </font></Button>
      <Button layoutX="260.0" layoutY="145.0" mnemonicParsing="false" onAction="#goCC" prefHeight="70.0" prefWidth="140.0" text="By Club &amp; Country" textAlignment="CENTER" wrapText="true">
         <font>
            <Font size="15.0" />
         </font></Button>
      <Button layoutX="410.0" layoutY="146.0" mnemonicParsing="false" onAction="#goCWP" prefHeight="150.0" prefWidth="160.0" text="Country Wise Player Count" textAlignment="CENTER" wrapText="true">
         <font>
            <Font size="15.0" />
         </font></Button>
      <ImageView fitHeight="250.0" fitWidth="260.0" layoutX="570.0" layoutY="200.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../images/Search-cuate.png" />
         </image>
      </ImageView>
   </children>
</AnchorPane>
