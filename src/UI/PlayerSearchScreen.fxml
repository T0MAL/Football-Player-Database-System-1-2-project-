<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.BoxBlur?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/" xmlns:fx="http://javafx.com/fxml/1" fx:controller="UI.PlayerSearchScreenCtrl">
   <children>
       <Label layoutX="337.0" layoutY="5.0" prefHeight="44.0" prefWidth="126.0" style="-fx-background-color: rgb(179,183,245); -fx-padding: 10 10 10 10; " text="Player Search" wrapText="true">
           <font>
               <Font name="Uni-Sans-Bold-Italic" size="18.0" />
           </font>
       </Label>

       <Button layoutX="5.0" layoutY="5.0" mnemonicParsing="false" onAction="#backButton" prefWidth="0.0" style="-fx-padding: 1 1 1 1; -fx-background-color: transparent">
           <graphic>
               <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                   <image>
                       <Image url="@../images/back.png" />
                   </image>
               </ImageView>
           </graphic>
           <effect>
               <BoxBlur />
           </effect>
       </Button>
      <TabPane fx:id="tabPane" layoutY="50.0" prefHeight="400.0" prefWidth="800.0" tabClosingPolicy="UNAVAILABLE">
        <tabs>
          <Tab fx:id="nameTab" onSelectionChanged="#nameTabPressed" text="By Name">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <TextField fx:id="nameKey" focusTraversable="false" layoutX="303.0" layoutY="25.0" onAction="#nameKeyPressed" promptText="Enter player name" />
                         <Label fx:id="nameNotFound" layoutX="333.0" layoutY="52.0" prefHeight="22.0" prefWidth="118.0" style="-fx-background-color: transparent;-fx-text-fill: linear-gradient(darkred, #38424b);" textAlignment="CENTER" wrapText="true">
                             <font>
                                 <Font size="10.0" />
                             </font></Label>

                         <TableView fx:id="nameTable" layoutY="70.0" prefHeight="280.0" prefWidth="785.0" />
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
          <Tab fx:id="positionTab" onSelectionChanged="#positionTabPressed" text="By Position">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <TextField fx:id="positionKey" focusTraversable="false" layoutX="303.0" layoutY="25.0" onAction="#positionKeyPressed" promptText="Enter player position" />
                         <Label fx:id="positionNotFound" layoutX="185.0" layoutY="52.0" prefHeight="22.0" prefWidth="414.0" style="-fx-background-color: transparent;-fx-text-fill: linear-gradient(darkred, #38424b);" textAlignment="CENTER" wrapText="true">
                             <font>
                                 <Font size="10.0" />
                             </font></Label>

                         <TableView fx:id="positionTable" layoutY="70.0" prefHeight="280.0" prefWidth="785.0" />
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
            <Tab fx:id="ccTab" onSelectionChanged="#ccTabPressed" text="By Club &amp; Country">
              <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <TextField fx:id="countryKey" focusTraversable="false" layoutX="100.0" layoutY="25.0" promptText="Enter Country Name" />
                        <TextField fx:id="clubKey" focusTraversable="false" layoutX="500.0" layoutY="25.0" promptText="Enter Club Name" />
                         <Label fx:id="ccNotFound" layoutX="307.0" layoutY="52.0" prefHeight="22.0" prefWidth="170.0" style="-fx-background-color: transparent;-fx-text-fill: linear-gradient(darkred, #38424b);" textAlignment="CENTER" wrapText="true">
                             <font>
                                 <Font size="10.0" />
                             </font></Label>

                         <TableView fx:id="ccTable" layoutY="70.0" prefHeight="280.0" prefWidth="785.0" />
                        <Button layoutX="343.0" layoutY="14.0" mnemonicParsing="false" onAction="#searchCCButt" prefHeight="38.0" prefWidth="98.0" text="Search" />
                        <Label fx:id="empty1" layoutX="136.0" layoutY="52.0" prefHeight="22.0" prefWidth="106.0" style="-fx-background-color: transparent;-fx-text-fill: linear-gradient(darkred, #38424b);" textAlignment="CENTER" wrapText="true">
                           <font>
                              <Font size="10.0" />
                           </font>
                        </Label>
                        <Label fx:id="empty2" layoutX="544.0" layoutY="52.0" prefHeight="22.0" prefWidth="89.0" style="-fx-background-color: transparent;-fx-text-fill: linear-gradient(darkred, #38424b);" textAlignment="CENTER" wrapText="true">
                           <font>
                              <Font size="10.0" />
                           </font>
                        </Label>
                        <RadioButton fx:id="oCountry" layoutX="118.0" layoutY="4.0" mnemonicParsing="false" onAction="#onlyCountry" prefHeight="19.0" prefWidth="142.0" text="Search By Country Only" wrapText="true">
                           <font>
                              <Font size="10.0" />
                           </font>
                        </RadioButton>
                     </children>
                  </AnchorPane>
              </content>
            </Tab>
            <Tab fx:id="srTab" onSelectionChanged="#srTabPressed" text="By Salary-Range">
              <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <TextField fx:id="minSalKey" focusTraversable="false" layoutX="100.0" layoutY="25.0" promptText="Minimum Range" />
                        <TextField fx:id="maxSalKey" focusTraversable="false" layoutX="500.0" layoutY="25.0" promptText="Maximum Range" />
                         <Label fx:id="srNotFound" layoutX="327.0" layoutY="52.0" prefHeight="22.0" prefWidth="129.0" style="-fx-background-color: transparent;-fx-text-fill: linear-gradient(darkred, #38424b);" textAlignment="CENTER" wrapText="true">
                             <font>
                                 <Font size="10.0" />
                             </font></Label>

                         <TableView fx:id="srTable" layoutY="70.0" prefHeight="280.0" prefWidth="785.0" />
                        <Button layoutX="343.0" layoutY="14.0" mnemonicParsing="false" onAction="#searchSRButt" prefHeight="38.0" prefWidth="98.0" text="Search" />
                        <Label fx:id="empty3" layoutX="133.0" layoutY="52.0" prefHeight="22.0" prefWidth="111.0" style="-fx-background-color: transparent;-fx-text-fill: linear-gradient(darkred, #38424b);" textAlignment="CENTER" wrapText="true">
                           <font>
                              <Font size="10.0" />
                           </font>
                        </Label>
                        <Label fx:id="empty4" layoutX="533.0" layoutY="52.0" prefHeight="22.0" prefWidth="111.0" style="-fx-background-color: transparent;-fx-text-fill: linear-gradient(darkred, #38424b);" textAlignment="CENTER" wrapText="true">
                           <font>
                              <Font size="10.0" />
                           </font>
                        </Label>
                     </children>
                  </AnchorPane>
              </content>
            </Tab>
            <Tab fx:id="cwpTab" onSelectionChanged="#cwpTabPressed" text="Country Wise Player Count">
              <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <TableView fx:id="cwpTable" layoutY="70.0" prefHeight="280.0" prefWidth="786.0" />
                     </children>
                  </AnchorPane>
              </content>
            </Tab>
        </tabs>
      </TabPane>
   </children>
</AnchorPane>
