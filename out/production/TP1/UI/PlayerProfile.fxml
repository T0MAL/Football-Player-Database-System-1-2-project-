<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="300.0" prefWidth="600.0" style="-fx-background-color: #1e5dd2;" xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1" fx:controller="UI.PlayerProfileCtrl">
   <children>
      <ImageView fx:id="img" fitHeight="250.0" fitWidth="250.0" layoutX="14.0" layoutY="49.0" pickOnBounds="true">
      </ImageView>
      <Label fx:id="name" layoutX="275.0" layoutY="14.0" prefHeight="54.0" prefWidth="350.0" text="CHRISTIANO RONALDO" textFill="WHITE">
         <font>
            <Font name="Segoe UI Black" size="24.0" />
         </font>
      </Label>
      <Label fx:id="country" layoutX="275.0" layoutY="68.0" prefHeight="20.0" prefWidth="239.0" text="Portugal" textFill="#cee409">
         <font>
            <Font name="Arial Rounded MT Bold" size="18.0" />
         </font>
      </Label>
      <Label fx:id="club" layoutX="275.0" layoutY="108.0" text="Manchester United" textFill="#050220">
         <font>
            <Font name="Arial Rounded MT Bold" size="14.0" />
         </font>
      </Label>
      <Label fx:id="number" layoutX="4.0" prefHeight="37.0" prefWidth="62.0" text="#7" textFill="WHITE">
         <font>
            <Font name="Segoe UI Black" size="36.0" />
         </font>
      </Label>
      <ListView fx:id="details" layoutX="275.0" layoutY="137.0" prefHeight="119.0" prefWidth="278.0" />
      <Button fx:id="sellforu" layoutX="348.0" layoutY="264.0" mnemonicParsing="false" onAction="#Sell" prefHeight="26.0" prefWidth="141.0" text="Sell" />
      <Label fx:id="position" layoutY="49.0" text="Forward" textFill="WHITE">
         <font>
            <Font name="Arial Rounded MT Bold" size="14.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
