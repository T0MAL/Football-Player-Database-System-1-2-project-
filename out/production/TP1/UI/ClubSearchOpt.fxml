<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.BoxBlur?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1" fx:controller="UI.ClubSearchOptCtrl">
    <children>
        <Label layoutX="330.0" layoutY="5.0" prefHeight="44.0" prefWidth="159.0" style="-fx-background-color: rgb(179,183,245); -fx-padding: 10 10 10 10; " text="Club Search Menu" wrapText="true">
            <font>
                <Font name="Uni-Sans-Bold-Italic" size="18.0" />
            </font>
        </Label>

        <Button layoutX="5.0" layoutY="5.0" mnemonicParsing="false" onAction="#backButton" prefWidth="0.0" style="-fx-padding: 1 1 1 1; -fx-background-color: transparent">
            <graphic>
                <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/back.png" />
                    </image>
                </ImageView>
            </graphic>
            <effect>
                <BoxBlur />
            </effect>
        </Button>
        <Button layoutX="111.0" layoutY="119.0" mnemonicParsing="false" onAction="#goSal" prefHeight="105.0" prefWidth="180.0" text="Player(s) with the maximum salary of a club" textAlignment="CENTER" wrapText="true">
            <font>
                <Font size="15.0" />
            </font></Button>
        <ImageView fitHeight="250.0" fitWidth="260.0" layoutX="570.0" layoutY="200.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../images/Search-cuate.png" />
            </image>
        </ImageView>
      <Button layoutX="308.0" layoutY="119.0" mnemonicParsing="false" onAction="#goAge" prefHeight="105.0" prefWidth="180.0" text="Player(s) with the maximum age of a club" textAlignment="CENTER" wrapText="true">
         <font>
            <Font size="15.0" />
         </font>
      </Button>
      <Button layoutX="111.0" layoutY="242.0" mnemonicParsing="false" onAction="#goHeight" prefHeight="105.0" prefWidth="180.0" text="Player(s) with the maximum height of a club" textAlignment="CENTER" wrapText="true">
         <font>
            <Font size="15.0" />
         </font>
      </Button>
      <Button layoutX="308.0" layoutY="242.0" mnemonicParsing="false" onAction="#goTotal" prefHeight="105.0" prefWidth="180.0" text=" Total yearly salary of a club" textAlignment="CENTER" wrapText="true">
         <font>
            <Font size="15.0" />
         </font>
      </Button>
    </children>

</AnchorPane>
